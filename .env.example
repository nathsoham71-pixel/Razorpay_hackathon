# Database
DATABASE_URL=postgresql+asyncpg://postgres:devpass@localhost:5432/razorpay_merchant_website
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
POSTGRES_DB=razorpay_merchant_website

# Global Razorpay test-mode fallback keys (merchants may override per-record)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# OpenAI (merchant agent upsell proposals)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# Feed upload directory
UPLOAD_DIR=/tmp/feed_uploads

# Production (Option B — public hosting)
# Set to your deployed API URL, no trailing slash (e.g. https://merchant-platform-api.onrender.com)
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated frontend URLs allowed to call the REST API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
